{
  "name": "dolly-design-studio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/build-image-manifest.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/media-template.test.mjs",
    "typecheck": "tsc --noEmit",
    "images": "node scripts/build-image-manifest.mjs",
    "cf:build": "node scripts/with-build-id.mjs cross-env DEPLOY_TARGET=cloudflare NEXT_PUBLIC_SITE_URL=https://dollydesignstudio.pages.dev opennextjs-cloudflare build",
    "cf:preview": "npm run cf:build && opennextjs-cloudflare preview",
    "cf:deploy": "npm run cf:build && opennextjs-cloudflare deploy",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.13",
    "ag-psd": "^34.1.0",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "cross-env": "10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "wrangler": "4.154.0"
  }
}
