{
	// Cloudflare deployment (Workers + static assets, built by OpenNext). See DEPLOY.md.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dolly-design-studio",
	// cf-worker.mjs wraps the built site (.open-next/worker.js) with a kept copy of each public page (see that file)
	"main": "cf-worker.mjs",
	"compatibility_date": "2025-09-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Resizes pictures on the fly, so visitors' devices get ones the size of their screen (see lib/image-loader.ts)
	"images": {
		"binding": "IMAGES"
	},
	// Tells the Worker which deployed version it is (a kept page copy is only used by the version that made it)
	"version_metadata": {
		"binding": "CF_VERSION"
	},
	"observability": {
		"enabled": true
	},
	// Visitor-data expiry (a no-op until VISITORS_DB is configured; see VISITORS.md).
	"triggers": { "crons": ["17 3 * * *"] },
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "dolly-design-studio"
		}
	],
	// Where the portal keeps its content, accounts and uploads. Create it once:  npx wrangler r2 bucket create dolly-portal
	"r2_buckets": [
		{
			"binding": "PORTAL_BUCKET",
			"bucket_name": "dolly-portal"
		},
		{
			"bucket_name": "dolly-portal",
			"binding": "dolly_portal",
			"remote": true
		}
	],
	// Requests per visitor address per minute, counted before Next is started (see lib/front-door-limits.mjs). The namespace ids are
	// just this account's own labels for the three counters.
	"ratelimits": [
		{ "name": "SIGN_IN_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "PORTAL_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } },
		{ "name": "PAGE_LIMIT", "namespace_id": "4103", "simple": { "limit": 120, "period": 60 } }
	],
	"vars": {
		"DEPLOY_TARGET": "cloudflare"
	}
}
