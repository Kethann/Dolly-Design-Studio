{
  // The pages.dev front (see DEPLOY.md): a Pages project that forwards to the "dolly-design-studio" Worker.
  // The public address, dollydstudio.pages.dev. The deploy also refreshes "dollydesignstudio" (the first address) with this front.
  "name": "dollydstudio",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2025-09-01",
  "services": [{ "binding": "WEB", "service": "dolly-design-studio" }]
}
