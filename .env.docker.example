# Copy to .env.docker.local, then fill in values yourself. Never commit that file.
# First run: sign in as admin with this password, then create your owner account.
PORTAL_PASSWORD=
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep this stable across restarts so sessions remain valid.
PORTAL_SECRET=

# Optional: use your existing studio mailbox settings here for enquiries and OTP.
# No email credentials are copied automatically from .env.local or Cloudflare.
CONTACT_TO_EMAIL=dollydesignstudios@gmail.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Or configure your existing SMTP/Resend settings as documented in .env.example.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# RESEND_API_KEY=
# MAIL_FROM=
