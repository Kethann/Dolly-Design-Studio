# Public site URL (used for SEO, sitemap and Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact form email delivery via Resend (https://resend.com). Optional in local dev:
# without a key, submissions are printed to the terminal instead of emailed.
RESEND_API_KEY=
CONTACT_TO_EMAIL=dollydesignstudios@gmail.com
CONTACT_FROM_EMAIL="Dolly Design Studio <onboarding@resend.dev>"

# Creator portal (/portal): the password the studio signs in with. Leave empty to keep the portal switched off.
# Optional PORTAL_SECRET signs the session cookie (defaults to one derived from the password).
PORTAL_PASSWORD=
PORTAL_SECRET=

# ── Email for the portal: forgot-password codes, two-step sign-in codes, confirming an email address ──────────────
# Easiest: a Gmail account with an "app password" (NOT your normal password).
#   Google account → Security → turn on 2-Step Verification → App passwords → create one → paste it below.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: the name and address people see the codes come from.
# SMTP_FROM="Dolly Design Studio <your.address@gmail.com>"
#
# Any other email service instead of Gmail (leave the two GMAIL lines empty if you use these):
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587            # 465 for SSL
# SMTP_SECURE=false        # "true" for port 465
# SMTP_USER=
# SMTP_PASS=

# On Cloudflare, mail connections (SMTP/Gmail) are not possible. Use Resend instead (https://resend.com, free tier):
# RESEND_API_KEY=re_...
# MAIL_FROM="Dolly Design Studio <portal@yourdomain.com>"   # a domain you verified in Resend
